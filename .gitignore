# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Python virtual environment
.venv/
venv/
ENV/
env/

# Environment variables
.env
.env.local
.env.*.local

# Node.js / React
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / Editor specific files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Data & Model artifacts (exclude actual data files, keep directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
ml/datasets/*
!ml/datasets/.gitkeep
ml/models/*
!ml/models/.gitkeep
