# Server Configuration
PORT=8000
HOST=127.0.0.1

# Security & CORS Setup (Comma-separated origins allowed to access backend API)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NASA FIRMS API Credentials
# Obtain your free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# If left empty, backend automatically falls back to official 24h public NASA FIRMS CSV feeds.
NASA_FIRMS_MAP_KEY=

# Future Environment Keys (Placeholders for future phases)
# DATABASE_URL=postgresql://user:password@localhost:5432/sih_db
